# Kanri Environment Variables Example
DATABASE_URL="file:./dev.db"

# PostgreSQL / Supabase connection (if migrating to remote cloud)
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public"

# AI Configuration (OpenAI, Groq, OpenRouter, or Gemini OpenAI-compatible)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Timezone
NEXT_PUBLIC_APP_TIMEZONE="America/Argentina/Buenos_Aires"
